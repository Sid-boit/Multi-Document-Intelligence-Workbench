    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "fastest-levenshtein": "^1.0.16",
    "file-type": "^22.3.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "p-limit": "^7.1.1",
    "papaparse": "^5.5.3",
    "pdf-parse": "^2.4.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.1.0"
