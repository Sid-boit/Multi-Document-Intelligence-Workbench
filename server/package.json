  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.18.0",
    "@types/papaparse": "^5.3.16",
    "@types/pdfkit": "^0.17.2",
    "@types/supertest": "^6.0.3",
    "pdfkit": "^0.21.0",
    "sharp": "^0.35.5",
